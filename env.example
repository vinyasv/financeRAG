# Finance RAG Configuration
# Copy to .env and add your API key:  cp env.example .env

# ═══════════════════════════════════════════════════════════════════════════
# API Key (Required)
# ═══════════════════════════════════════════════════════════════════════════

# Option 1: OpenRouter (recommended - one key for all models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Optional Settings (defaults work well, only change if needed)
# ═══════════════════════════════════════════════════════════════════════════

# LLM_PROVIDER=auto
# LLM_MODEL=google/gemini-3-flash-preview
# EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Retrieval
# USE_RERANKING=true
# RERANKER_MODEL=rank-T5-flan

# Chunking
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
